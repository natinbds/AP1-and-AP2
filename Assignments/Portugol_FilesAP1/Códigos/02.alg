Algoritmo "Questao_02" 

Var 
   n,i :inteiro 
Inicio 
   escreval("Digite o Até qual valor quer a contagem, progressiva:") 
   leia(n) 
   i<-1 
  
   repita 
  
     enquanto n <= 0 faca 
     escreval ("erro") 
     leia (n) 
     fimenquanto 
      escreval(i) 
      i<- i+1 
  
   ate(i > n) 
  
Fimalgoritmo
